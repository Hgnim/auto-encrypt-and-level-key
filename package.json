{
  "name": "auto-encrypt-and-level-key",
  "version": "1.0.1",
  "description": "",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/external/client.js",
  "import": "./dist/external/client.js",
  "browser": "./dist/external/client.js",
  "default": "./dist/external/client.js",
  "types": "./dist/external/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/external/client/index.d.ts",
      "import": "./dist/external/client.js",
      "browser": "./dist/external/client.js",
      "default": "./dist/external/client.js"
    },
    "./node": {
      "types": "./dist/external/node/index.d.ts",
      "node": "./dist/external/node.js"
    },
    "./client": {
      "types": "./dist/external/client/index.d.ts",
      "import": "./dist/external/client.js",
      "browser": "./dist/external/client.js",
      "default": "./dist/external/client.js"
    },
    "./bundle/node": {
      "types": "./dist/bundle/node/index.d.ts",
      "node": "./dist/bundle/node.js"
    },
    "./bundle/client": {
      "types": "./dist/bundle/client/index.d.ts",
      "import": "./dist/bundle/client.js",
      "browser": "./dist/bundle/client.js",
      "default": "./dist/bundle/client.js"
    }
  },
  "scripts": {
    "build": "npm run build:external && npm run build:bundle",
    "build:external": "vite build",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hgnim/auto-encrypt-and-level-key.git"
  },
  "keywords": [],
  "author": "Hgnim",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/Hgnim/auto-encrypt-and-level-key/issues"
  },
  "homepage": "https://github.com/Hgnim/auto-encrypt-and-level-key#readme",
  "devDependencies": {
    "@types/imurmurhash": "^0.1.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "ez-encrypt": "github:Hgnim/ez-encrypt",
    "imurmurhash": "^0.1.4",
    "js-cookie": "^3.0.8"
  }
}